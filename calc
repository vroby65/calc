#!/usr/bin/env bash

buttons=(C DEL '(' ')' 7 8 9 / 4 5 6 '*' 1 2 3 - 0 . '=' + Q)
readonly key_columns=4 key_rows=5 key_width=8 key_height=3
readonly keypad_left=3 keypad_top=7
readonly quit_index=$((key_columns * key_rows))
readonly quit_left=$((keypad_left + (key_columns - 1) * key_width))
readonly quit_row=$((keypad_top - 1))
readonly frame_width=$((key_columns * key_width + 4))
readonly frame_height=$((keypad_top + key_rows * key_height))

# Panel, header, and cursor colors from fm's 256-color theme.
readonly panel_color=$'\e[38;5;144;48;5;237m'
readonly result_color=$'\e[1;33;48;5;237m'
readonly focus_color=$'\e[38;5;252;48;5;23m'

# Consume tokens from remaining and return a bc expression in parsed.
parse_expression() {
    local minimum=$1 left operator precedence sign=1
    while [[ $remaining == [+-]* ]]; do
        [[ $remaining == -* ]] && sign=$((-sign))
        remaining=${remaining:1}
    done
    if [[ $remaining == '('* ]]; then
        remaining=${remaining:1}
        parse_expression 1 && [[ $remaining == ')'* ]] || return 1
        left=$parsed
        remaining=${remaining:1}
    elif [[ $remaining =~ ^([0-9]+([.][0-9]*)?|[.][0-9]+) ]]; then
        left=${BASH_REMATCH[0]}
        if [[ $left == 0* && $left != *.* && $left == *[1-9]* ]]; then
            return 1
        fi
        remaining=${remaining:${#left}}
    else
        return 1
    fi
    (( sign < 0 )) && left="(-$left)"

    while :; do
        case $remaining in
            //*) operator=//; precedence=2 ;;
            [*/%]*) operator=${remaining:0:1}; precedence=2 ;;
            [+-]*) operator=${remaining:0:1}; precedence=1 ;;
            *) break ;;
        esac
        (( precedence >= minimum )) || break
        remaining=${remaining:${#operator}}
        parse_expression "$((precedence + 1))" || return 1
        case $operator in
            //) left="f($left,$parsed)" ;;
            %) left="r($left,$parsed)" ;;
            *) left="($left $operator $parsed)" ;;
        esac
    done
    parsed=$left
}

evaluate() {
    local remaining=$1 parsed result
    if ! parse_expression 1 || [[ -n $remaining ]]; then
        printf 'Error\n'
        return
    fi

    # bc truncates integer division toward zero. f() rounds down, r() keeps
    # the divisor's sign, and n() rounds the result to 10 decimal places.
    result=$(
        unset POSIXLY_CORRECT
        LC_ALL=C BC_ENV_ARGS='' BC_LINE_LENGTH=0 bc -q 2>&1 <<BC
scale=30
define f(a,b) {
    auto s,q
    s=scale
    scale=0
    q=a/b
    scale=s
    if (a!=q*b && ((a<0 && b>0) || (a>0 && b<0))) q=q-1
    return(q)
}
define r(a,b) {
    return(a-b*f(a,b))
}
define n(x) {
    auto s,y,d
    s=scale
    scale=10
    y=x/1
    scale=s
    d=x-y
    if (d<0) d=-d
    if (d>.00000000005 || (d==.00000000005 && r(y*10000000000,2)!=0)) {
        if (x<0) return(y-.0000000001)
        return(y+.0000000001)
    }
    return(y)
}
n($parsed)
BC
    )
    if [[ ! $result =~ ^-?([0-9]*[.])?[0-9]+$ ]]; then
        printf 'Error\n'
        return
    fi
    case $result in
        .*) result=0$result ;;
        -.*) result=-0${result#-} ;;
    esac
    if [[ $result == *.* ]]; then
        while [[ $result == *0 ]]; do result=${result%0}; done
        result=${result%.}
    fi
    printf '%s\n' "$result"
}

press() {
    local label=$1
    case $label in
        C) entry=; shown= ;;
        DEL) entry=${entry%?}; shown= ;;
        =)
            if [[ -n $entry ]]; then shown=$(evaluate "$entry"); fi
            ;;
        *)
            if [[ -n $shown ]]; then
                case $label in
                    [*/+-]) entry=$shown ;;
                    *) entry= ;;
                esac
            fi
            entry+=$label
            shown=
            ;;
    esac
}

draw() {
    local rows=$1 columns=$2
    local expr='' result row col y index label left right style top middle bottom
    local rule='──────────────────────────────'
    (( rows >= frame_height && columns >= frame_width )) || return 0

    [[ -n $shown ]] && expr=$entry
    result=${shown:-${entry:-0}}
    (( ${#expr} > 30 )) && expr=${expr: -30}
    (( ${#result} > 30 )) && result=${result: -30}
    printf '%s\e[1;1H┌──%s──┐\e[2;1H│ ┌%s┐ │' "$panel_color" "$rule" "$rule"
    printf '\e[3;1H│ │\e[2m%30s\e[22m│ │' "$expr"
    printf '\e[4;1H│ │%s%30s\e[0m%s│ │' "$result_color" "$result" "$panel_color"
    printf '\e[5;1H│ └%s┘ │' "$rule"
    style=
    (( selected == quit_index )) && style=$focus_color
    printf '\e[%d;1H│%*s%s[  \e[1mQ\e[22m   ]%s │' \
        "$quit_row" "$((quit_left - 2))" '' "$style" "$panel_color"

    for ((row = 0; row < key_rows; row++)); do
        top='' middle='' bottom=''
        y=$((keypad_top + row * key_height))
        for ((col = 0; col < key_columns; col++)); do
            index=$((row * key_columns + col))
            label=${buttons[index]}
            left=$(((key_width - 2 - ${#label}) / 2))
            right=$((key_width - 2 - ${#label} - left))
            style=$panel_color
            (( index == selected )) && style=$focus_color
            top+=$style'┌──────┐'
            printf -v middle '%s%s│%*s\e[1m%s\e[22m%*s│' \
                "$middle" "$style" "$left" '' "$label" "$right" ''
            bottom+=$style'└──────┘'
        done
        printf '\e[%d;1H│ %s%s │\e[%d;1H│ %s%s │\e[%d;1H│ %s%s │' \
            "$y" "$top" "$panel_color" "$((y + 1))" "$middle" "$panel_color" \
            "$((y + 2))" "$bottom" "$panel_color"
    done
    printf '\e[%d;1H└──%s──┘\e[0m' "$frame_height" "$rule"
}

read_key() {
    local prefix char status
    IFS= read -r -N 1 -t 0.25 key
    status=$?
    [[ -n $key ]] || return "$status"
    [[ $key == $'\e' ]] || return 0
    IFS= read -r -N 1 -t 0.1 prefix || return 0
    [[ $prefix == '[' || $prefix == O ]] || return 0
    key=$prefix
    while IFS= read -r -N 1 -t 0.1 char; do
        key+=$char
        [[ $char == [@-~] ]] && break
    done
    return 0
}

main() {
    local entry='' shown='' selected=5 key index row col rows columns resize_pending=1
    local click_pattern='^\[<0;([1-9][0-9]{0,4});([1-9][0-9]{0,4})M$'
    if [[ ! -t 0 || ! -t 1 ]]; then
        printf 'Run calc in a terminal.\n' >&2
        return 1
    fi
    if ! command -v bc >/dev/null; then
        printf 'calc requires GNU bc.\n' >&2
        return 1
    fi

    tty_state=$(stty -g) || return 1
    trap 'stty "$tty_state"; printf "\e[0m\e[?1000l\e[?1006l\e[?25h"' EXIT
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM
    trap 'resize_pending=1' WINCH
    stty raw -echo || return 1
    printf '\e[?25l\e[?1000h\e[?1006h'

    while :; do
        if (( resize_pending )); then
            resize_pending=0
            read -r rows columns <<< "$(stty size)"
            if (( rows < 1 || columns < 1 )); then
                rows=24 columns=80
            fi
            draw "$rows" "$columns"
        fi
        read_key
        case $? in
            0) ;;
            1) return 0 ;;
            *) continue ;;
        esac
        row=$((selected / key_columns))
        col=$((selected % key_columns))
        case $key in
            $'\e'|$'\x03') return 0 ;;
            '[A'|OA)
                if (( selected == quit_index )); then
                    selected=$((quit_index - 1))
                elif (( selected == key_columns - 1 )); then
                    selected=$quit_index
                else
                    selected=$(((row + key_rows - 1) % key_rows * key_columns + col))
                fi
                ;;
            '[B'|OB)
                if (( selected == quit_index )); then
                    selected=$((key_columns - 1))
                elif (( selected == quit_index - 1 )); then
                    selected=$quit_index
                else
                    selected=$(((row + 1) % key_rows * key_columns + col))
                fi
                ;;
            '[C'|OC)
                (( selected == quit_index )) || selected=$((row * key_columns + (col + 1) % key_columns))
                ;;
            '[D'|OD)
                (( selected == quit_index )) || selected=$((row * key_columns + (col + key_columns - 1) % key_columns))
                ;;
            '[<'*)
                [[ $key =~ $click_pattern ]] || continue
                (( rows >= frame_height && columns >= frame_width )) || continue
                col=${BASH_REMATCH[1]}
                row=${BASH_REMATCH[2]}
                if (( row == quit_row && col >= quit_left && col < quit_left + key_width )); then
                    key=Q
                else
                    col=$((col - keypad_left))
                    row=$((row - keypad_top))
                    (( col >= 0 && col < key_columns * key_width &&
                       row >= 0 && row < key_rows * key_height )) || continue
                    key=${buttons[row / key_height * key_columns + col / key_width]}
                fi
                ;;
            $'\r'|$'\n') key='=' ;;
            $'\x7f'|$'\b') key=DEL ;;
            ' ') key=${buttons[selected]} ;;
        esac
        if [[ $key == [qQ] ]]; then
            printf '\e[2J\e[H'
            return 0
        fi
        for index in "${!buttons[@]}"; do
            if [[ $key == "${buttons[index]}" ]]; then
                selected=$index
                press "$key"
                break
            fi
        done
        draw "$rows" "$columns"
    done
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
    main
fi
